{
  "compilerOptions": {
    "outDir": "./dist",             // Pasta de saída para os arquivos compilados
    "rootDir": ".",                 // Inclui a pasta raiz do projeto
    "target": "ES6",                // Define o padrão de ECMAScript para compilação
    "strict": true,                 // Ativa todas as verificações de tipo estritas
    "esModuleInterop": true,        // Habilita a interoperabilidade com módulos CommonJS
    "skipLibCheck": true,           // Ignora a verificação dos arquivos de declaração de tipo (*.d.ts)
    "forceConsistentCasingInFileNames": true, // Garante consistência no nome de arquivos (case-sensitive)
    "resolveJsonModule": true,      // Permite importar arquivos JSON como módulos
    "noEmitOnError": true,          // Não gera arquivos se houver erros de compilação
    "module": "ES6",                // Usa o sistema de módulos ES6
    "moduleResolution": "node",     // Resolve os módulos de acordo com o Node.js
    "allowJs": true,                // Permite incluir arquivos JavaScript
    "declaration": true,            // Gera arquivos .d.ts para os módulos
    "sourceMap": true               // Gera arquivos de mapa de fontes para depuração
  },
  "include": [
    "src/**/*",                     // Inclui todos os arquivos TS dentro da pasta src
    "tests/**/*"                    // Inclui todos os arquivos TS dentro da pasta tests
  ],
  "exclude": [
    "node_modules"                  // Exclui a pasta node_modules
  ]
}
